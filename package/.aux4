{
  "scope": "aux4",
  "name": "todo",
  "version": "1.4.0",
  "description": "Todo list manager for aux4",
  "license": "Apache-2.0",
  "tags": [
    "todo",
    "task",
    "list",
    "json"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "todo",
          "execute": [
            "profile:todo"
          ],
          "help": {
            "text": "Manage todo lists"
          }
        }
      ]
    },
    {
      "name": "todo",
      "commands": [
        {
          "name": "list",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js list values(file) --format ${format}"
          ],
          "help": {
            "text": "List all todo lists with progress",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "view",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js view values(file, name, status) --format ${format}"
          ],
          "help": {
            "text": "View a slim one-line index of a todo list",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "status",
                "text": "Filter by status: open, doing, done, or all (default: open+doing)",
                "default": ""
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "show",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js show values(file, name, id, full, comments) --format ${format}"
          ],
          "help": {
            "text": "Show full detail for a single item (description + status + comments)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "full",
                "text": "Show the entire description instead of a chunk",
                "default": "false"
              },
              {
                "name": "comments",
                "text": "Number of recent comments to show",
                "default": "3"
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "new",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js add values(file, name, prefix, item, assignee, description)"
          ],
          "help": {
            "text": "Create a new todo list with a prefix and optional initial item",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "prefix",
                "text": "Task ID prefix (2-10 uppercase letters, e.g. SPR, SEO)"
              },
              {
                "name": "item",
                "text": "Initial todo item (optional)",
                "default": ""
              },
              {
                "name": "assignee",
                "text": "Assignee name (optional)",
                "default": ""
              },
              {
                "name": "description",
                "text": "Long description (optional)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "add",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js addItem values(file, name, item, assignee, description)"
          ],
          "help": {
            "text": "Add a new item to an existing todo list",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "item",
                "text": "Item text (multiple words supported)"
              },
              {
                "name": "assignee",
                "text": "Assignee name (optional)",
                "default": ""
              },
              {
                "name": "description",
                "text": "Long description (optional)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js removeItem values(file, name, id)"
          ],
          "help": {
            "text": "Remove an item from a todo list",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              }
            ]
          }
        },
        {
          "name": "complete",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js complete values(file, name, id, status)"
          ],
          "help": {
            "text": "Mark todo item as complete or incomplete",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "status",
                "text": "Completion status",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "move",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js move values(file, name, id, status)"
          ],
          "help": {
            "text": "Move a todo item to a status (open, doing, done)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "status",
                "text": "Target status",
                "options": [
                  "open",
                  "doing",
                  "done"
                ]
              }
            ]
          }
        },
        {
          "name": "subtask",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js subtask values(file, name, id, item, assignee, description)"
          ],
          "help": {
            "text": "Add a subtask to a todo item",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Parent item id (required)"
              },
              {
                "name": "item",
                "text": "Subtask text"
              },
              {
                "name": "assignee",
                "text": "Assignee name (optional)",
                "default": ""
              },
              {
                "name": "description",
                "text": "Long description (optional)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "subtasks",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js subtasks values(file, name, id) --format ${format}"
          ],
          "help": {
            "text": "View subtasks of a todo item",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Parent item id (required)"
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "describe",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js describe values(file, name, id, description)"
          ],
          "help": {
            "text": "Set or update the description of a todo item",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "description",
                "text": "Long description text"
              }
            ]
          }
        },
        {
          "name": "rename",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js rename values(file, name, id, text) --format ${format}"
          ],
          "help": {
            "text": "Rename a todo item (change its text)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "text",
                "text": "New item text (non-empty)"
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "rename-list",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js renameList values(file, name, newName) --format ${format}"
          ],
          "help": {
            "text": "Rename a todo list (change its name, keeping all items)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Current todo list name (required)",
                "arg": true
              },
              {
                "name": "newName",
                "text": "New todo list name (must not already exist)"
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "assign",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js assign values(file, name, id, assignee)"
          ],
          "help": {
            "text": "Assign a todo item to someone",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "assignee",
                "text": "Assignee name (empty to unassign)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "comment",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js comment values(file, name, id, author, message)"
          ],
          "help": {
            "text": "Add a comment to a todo item",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "author",
                "text": "Comment author name"
              },
              {
                "name": "message",
                "text": "Comment text"
              }
            ]
          }
        },
        {
          "name": "comments",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js comments values(file, name, id, limit, offset) --format ${format}"
          ],
          "help": {
            "text": "View comments on a todo item, newest first (paginated)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "limit",
                "text": "Number of comments to show",
                "default": "3"
              },
              {
                "name": "offset",
                "text": "Number of newest comments to skip",
                "default": "0"
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "comment-remove",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js commentRemove values(file, name, id, index, author) --format ${format}"
          ],
          "help": {
            "text": "Remove a comment from a todo item by its 0-based array index. If an author is given, the comment is only removed when it belongs to that author (server-side own-comment gate).",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              },
              {
                "name": "index",
                "text": "Comment array index to remove (0-based)"
              },
              {
                "name": "author",
                "text": "If set, only remove the comment when it belongs to this author",
                "default": ""
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        },
        {
          "name": "archive",
          "execute": [
            "profile:todo:archive"
          ],
          "help": {
            "text": "Archive commands (add, remove, list)"
          }
        },
        {
          "name": "reference",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js reference values(file, name, prefix, target)"
          ],
          "help": {
            "text": "Add a cross-file reference to resolve foreign task prefixes",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "prefix",
                "text": "Foreign prefix to reference (e.g. SEO)"
              },
              {
                "name": "target",
                "text": "Target file and list (e.g. ../seo/.todo.json#seo-tasks)"
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js remove values(file, name)"
          ],
          "help": {
            "text": "Delete an entire todo list",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "merge",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js merge param(into) param(source**) --format ${format}"
          ],
          "help": {
            "text": "Merge one or more todo files into one (schema-aware: per stream unions tasks/order/archived and takes counter=max). Also restores an offloaded archive back into a live ledger.",
            "variables": [
              {
                "name": "source",
                "text": "Source todo file(s) to merge, left to right; the first is the base and wins on id conflict (required)",
                "arg": true,
                "multiple": true
              },
              {
                "name": "into",
                "text": "Write the merged result to this file in place; omit to print the merged JSON to stdout",
                "default": ""
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "todo:archive",
      "commands": [
        {
          "name": "add",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js archiveAdd values(file, name, id)"
          ],
          "help": {
            "text": "Archive an item (hidden from view and list counts)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js archiveRemove values(file, name, id)"
          ],
          "help": {
            "text": "Restore an archived item back to the active list",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              },
              {
                "name": "id",
                "text": "Item id (required)"
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js archiveList values(file, name)"
          ],
          "help": {
            "text": "List archived items of a todo list (slim one-line index)",
            "variables": [
              {
                "name": "file",
                "text": "Todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name (required)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "offload",
          "execute": [
            "node ${packageDir}/lib/aux4-todo.js offload values(file, name, into) --format ${format}"
          ],
          "help": {
            "text": "Move archived items out of the live file into a separate archive file to shrink the ledger. The archive file is a normal todo file, so offloaded history stays readable with 'todo archive list --file <archive>'.",
            "variables": [
              {
                "name": "file",
                "text": "Live todo file path",
                "default": ".todo.json"
              },
              {
                "name": "name",
                "text": "Todo list name to offload; omit to offload every list in the file",
                "arg": true,
                "default": ""
              },
              {
                "name": "into",
                "text": "Destination archive file to merge into (default: the live file with a .archive.json suffix, e.g. .todo.archive.json)",
                "default": ""
              },
              {
                "name": "format",
                "text": "Output format: text (default) or json",
                "default": "text"
              }
            ]
          }
        }
      ]
    }
  ]
}
